{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frp:schema:m24-formal-bounded-verification-manifest-v2.6.0",
  "title": "FRP M24 Formal and Bounded Verification Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "milestone", "status", "source_commit", "workflow_path", "source_count", "sources", "upstream_dependency_count", "upstream_dependencies", "artifact_count", "artifacts", "artifact_set_digest", "manifest_digest"],
  "$defs": {
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "raw_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  },
  "properties": {
    "schema_version": {"const": "2.6.0"}, "artifact_id": {"const": "frp-m24-formal-bounded-verification-manifest"}, "milestone": {"const": "M24"}, "status": {"const": "PASS"},
    "source_commit": {"const": "1dcc4e4d47135cdf1e38192cc96f0d928066b13e"},
    "workflow_path": {"const": ".github/workflows/frp-m24-formal-bounded-verification-closure-workflow.yml"},
    "source_count": {"const": 15}, "sources": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/file"}},
    "upstream_dependency_count": {"const": 13}, "upstream_dependencies": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/file"}},
    "artifact_count": {"const": 3}, "artifacts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/file"}},
    "artifact_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
