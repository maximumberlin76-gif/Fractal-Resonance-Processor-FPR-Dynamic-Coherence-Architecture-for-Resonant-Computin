{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frp:schema:m24-property-inventory-v2.6.0",
  "title": "FRP M24 Property Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "milestone", "status", "source_commit", "contract_digest", "property_count", "passed_count", "failed_count", "properties", "property_set_digest"],
  "$defs": {
    "property": {
      "type": "object", "additionalProperties": false,
      "required": ["property_id", "domain", "kind", "statement", "run_id", "assumption_ids", "harness", "status", "property_digest"],
      "properties": {
        "property_id": {"type": "string", "pattern": "^M24-P(0[1-9]|[12][0-9]|3[0-6])$"},
        "domain": {"enum": ["canonical_ternary", "active_neutral", "pending_route", "scheduler_counter", "request_lane", "transition_capacity", "retained_state", "invariant_flag", "reset_readiness", "bounded_liveness"]},
        "kind": {"enum": ["safety", "bounded_sequence", "bounded_liveness", "initial_state"]},
        "statement": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "pattern": "^M24-R0[1-5]$"},
        "assumption_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^M24-A(0[1-9]|1[01])$"}},
        "harness": {"type": "string", "pattern": "^formal/m24/.+\\.sv$"},
        "status": {"const": "PASS"},
        "property_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.6.0"},
    "artifact_id": {"const": "frp-m24-property-inventory"},
    "milestone": {"const": "M24"},
    "status": {"const": "PASS"},
    "source_commit": {"const": "1dcc4e4d47135cdf1e38192cc96f0d928066b13e"},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "property_count": {"const": 36},
    "passed_count": {"const": 36},
    "failed_count": {"const": 0},
    "properties": {"type": "array", "minItems": 36, "maxItems": 36, "items": {"$ref": "#/$defs/property"}},
    "property_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
