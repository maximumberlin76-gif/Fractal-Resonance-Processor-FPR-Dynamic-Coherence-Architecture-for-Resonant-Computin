{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frp.example/schemas/m26/frp_m26_tool_command_provenance.v2.8.0.schema.json",
  "title": "FRP M26 tool and command provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "milestone", "status", "source_commit", "contract_digest", "toolchain", "target_id", "constraint_record", "source_count", "sources", "commands", "determinism_controls", "provenance_digest"],
  "properties": {
    "schema_version": {"const": "2.8.0"},
    "artifact_id": {"const": "frp-m26-tool-command-provenance"},
    "milestone": {"const": "M26"},
    "status": {"const": "PASS"},
    "source_commit": {"const": "d83e23785d292adaaf419c31e51abb294ddf98f9"},
    "contract_digest": {"$ref": "#/$defs/digest"},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yosys", "nextpnr"],
      "properties": {
        "yosys": {"$ref": "#/$defs/tool"},
        "nextpnr": {"$ref": "#/$defs/tool"}
      }
    },
    "target_id": {"const": "ice40-hx8k-ct256-cells8"},
    "constraint_record": {"$ref": "#/$defs/file"},
    "source_count": {"type": "integer", "minimum": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "commands": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "stage", "run_id", "argv"],
        "properties": {
          "command_id": {"type": "string", "pattern": "^M26-CMD-[0-9]{2}-(YOSYS|NEXTPNR)$"},
          "stage": {"enum": ["synthesis", "place_route_timing_resource"]},
          "run_id": {"enum": ["RUN_A", "RUN_B"]},
          "argv": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "determinism_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "threads", "python_hash_seed", "locale", "timezone"],
      "properties": {
        "seed": {"const": 26},
        "threads": {"const": 1},
        "python_hash_seed": {"const": 0},
        "locale": {"const": "C.UTF-8"},
        "timezone": {"const": "UTC"}
      }
    },
    "provenance_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "raw_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "raw_sha256": {"$ref": "#/$defs/digest"}}},
    "tool": {"type": "object", "required": ["package", "package_version", "engine", "engine_version", "version_output"], "properties": {"package": {"type": "string", "minLength": 1}, "package_version": {"type": "string", "minLength": 1}, "engine": {"type": "string", "minLength": 1}, "engine_version": {"type": "string", "minLength": 1}, "engine_git_sha": {"type": "string"}, "version_output": {"type": "string", "minLength": 1}}}
  }
}
