    "registryRecord": {
      "type": "object",
      "required": [
        "artifact_format",
        "artifact_role",
        "canonical_artifact_paths",
        "identity_basis",
        "identity_class",
        "measurement_contour",
        "producer_path",
        "producer_version",
        "required",
        "schema_identifier",
        "schema_path",
        "schema_urn",
        "schema_version",
        "supported",
        "upstream_milestone",
        "upstream_release",
        "validation_mode"
      ],
      "properties": {
        "artifact_format": {
          "type": "string",
          "const": "json"
        },
        "artifact_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "canonical_artifact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "identity_basis": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "identity_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "measurement_contour": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "producer_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/repositoryPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer_version": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "schema_identifier": {
          "type": "string",
          "pattern": "^frp(?:\\.[a-z0-9_]+)+\\.v[0-9]+(?:\\.[0-9]+){0,2}$"
        },
        "schema_path": {
          "type": "string",
          "pattern": "^schemas/m18/frp(?:\\.[a-z0-9_]+)+\\.v[0-9]+(?:\\.[0-9]+){0,2}\\.schema\\.json$"
        },
        "schema_urn": {
          "type": "string",
          "pattern": "^urn:frp:schema:frp(?:\\.[a-z0-9_]+)+\\.v[0-9]+(?:\\.[0-9]+){0,2}$"
        },
        "schema_version": {
          "type": "string",
          "enum": [
            "1",
            "1.7.0",
            "2.0.0"
          ]
        },
        "supported": {
          "type": "boolean"
        },
        "upstream_milestone": {
          "type": "string",
          "minLength": 1
        },
        "upstream_release": {
          "type": "string",
          "minLength": 1
        },
        "validation_mode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
