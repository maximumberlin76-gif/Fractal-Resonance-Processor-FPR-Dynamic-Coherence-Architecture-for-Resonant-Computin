    "artifactRecord": {
      "type": "object",
      "required": [
        "artifact_class",
        "byte_length",
        "canonical",
        "filename",
        "format",
        "identification_basis",
        "measurement_contour",
        "mutable",
        "producer",
        "producer_version",
        "repository_path",
        "schema_identifier",
        "sha256"
      ],
      "properties": {
        "artifact_class": {
          "type": "string",
          "enum": [
            "formal_schema",
            "schema_registry",
            "structured_output",
            "benchmark_matrix_json",
            "benchmark_matrix_csv",
            "comparative_benchmark",
            "m15_export",
            "m15_vector_member"
          ]
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "canonical": {
          "type": "boolean",
          "const": true
        },
        "filename": {
          "$ref": "#/$defs/filename"
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "headered_vector",
            "headered_trace",
            "vector_text"
          ]
        },
        "identification_basis": {
          "type": "string",
          "enum": [
            "embedded_schema",
            "registry_binding",
            "format_header",
            "package_role"
          ]
        },
        "measurement_contour": {
          "type": "string",
          "enum": [
            "comparative_architecture_benchmark_suite",
            "hardware_informed_sensitivity_qualification",
            "m15_implementation_mapping_matrix",
            "m18_canonical_artifact_publication"
          ]
        },
        "mutable": {
          "type": "boolean",
          "const": false
        },
        "producer": {
          "oneOf": [
            {
              "$ref": "#/$defs/repositoryPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer_command": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "producer_version": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "schema_identifier": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^frp(?:\\.[a-z0-9_]+)+\\.v[0-9]+(?:\\.[0-9]+){0,2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "identification_basis": {
                "enum": [
                  "embedded_schema",
                  "registry_binding"
                ]
              }
            },
            "required": [
              "identification_basis"
            ]
          },
          "then": {
            "properties": {
              "schema_identifier": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identification_basis": {
                "const": "format_header"
              }
            },
            "required": [
              "identification_basis"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "enum": [
                  "headered_vector",
                  "headered_trace"
                ]
              },
              "schema_identifier": {
                "const": "frp.m15.vector.v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identification_basis": {
                "const": "package_role"
              }
            },
            "required": [
              "identification_basis"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "const": "vector_text"
              },
              "schema_identifier": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.?$)(?!.*[/\\\\]).+$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
