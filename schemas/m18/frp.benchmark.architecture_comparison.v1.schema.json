{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frp:schema:frp.benchmark.architecture_comparison.v1",
  "title": "FRP Comparative Architecture Result v1",
  "description": "Formal schema for canonical FRP Comparative Architecture Benchmark Suite result packages.",
  "type": "object",
  "x-frp-schema-identifier": "frp.benchmark.architecture_comparison.v1",
  "x-frp-artifact-role": "canonical_comparative_architecture_result",
  "x-frp-schema-version": "1",
  "x-frp-producer-path": "benchmarks/architecture_comparison/run_architecture_comparison.py",
  "x-frp-producer-version": null,
  "required": [
    "schema",
    "suite_name",
    "benchmark_kind",
    "frp_reference_version",
    "frp_scheduler",
    "architecture_order",
    "workload_profile",
    "workload_sha256",
    "cost_profile",
    "cost_profile_sha256",
    "thermal_profile",
    "thermal_profile_sha256",
    "architectures",
    "comparison_matrix",
    "integrity",
    "qualification",
    "comparison_package_sha256"
  ],
  "properties": {
    "schema": {
      "const": "frp.benchmark.architecture_comparison.v1"
    },
    "suite_name": {
      "const": "FRP Comparative Architecture Benchmark Suite"
    },
    "benchmark_kind": {
      "const": "comparative_architecture_matrix"
    },
    "frp_reference_version": {
      "const": "1.7.0"
    },
    "frp_scheduler": {
      "enum": [
        "free",
        "7/1",
        "1/7"
      ]
    },
    "architecture_order": {
      "const": [
        "binary_synchronous_reference",
        "binary_clock_gated_reference",
        "direct_ternary_reference",
        "frp_v1_7_0_quantized_shadow"
      ]
    },
    "workload_profile": {
      "$ref": "#/$defs/workloadProfile"
    },
    "workload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cost_profile": {
      "$ref": "#/$defs/costProfile"
    },
    "cost_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "thermal_profile": {
      "$ref": "#/$defs/thermalProfile"
    },
    "thermal_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "architectures": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/architectureRecord",
          "type": "object",
          "properties": {
            "architecture_id": {
              "const": "binary_synchronous_reference"
            },
            "architecture_name": {
              "const": "Binary Synchronous Reference"
            },
            "architecture_specific_metrics": {
              "$ref": "#/$defs/binarySynchronousMetrics"
            }
          }
        },
        {
          "$ref": "#/$defs/architectureRecord",
          "type": "object",
          "properties": {
            "architecture_id": {
              "const": "binary_clock_gated_reference"
            },
            "architecture_name": {
              "const": "Binary Clock-Gated Reference"
            },
            "architecture_specific_metrics": {
              "$ref": "#/$defs/binaryClockGatedMetrics"
            }
          }
        },
        {
          "$ref": "#/$defs/architectureRecord",
          "type": "object",
          "properties": {
            "architecture_id": {
              "const": "direct_ternary_reference"
            },
            "architecture_name": {
              "const": "Direct Ternary Reference"
            },
            "architecture_specific_metrics": {
              "$ref": "#/$defs/directTernaryMetrics"
            }
          }
        },
        {
          "$ref": "#/$defs/architectureRecord",
          "type": "object",
          "properties": {
            "architecture_id": {
              "const": "frp_v1_7_0_quantized_shadow"
            },
            "architecture_name": {
              "const": "FRP v1.7.0 Quantized Hardware Shadow Reference"
            },
            "architecture_specific_metrics": {
              "$ref": "#/$defs/frpMetrics"
            }
          }
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": false
    },
    "comparison_matrix": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/comparisonRow",
          "type": "object",
          "properties": {
            "architecture_id": {
              "const": "binary_synchronous_reference"
            }
          }
        },
        {
          "$ref": "#/$defs/comparisonRow",
          "type": "object",
          "properties": {
            "architecture_id": {
              "const": "binary_clock_gated_reference"
            }
          }
        },
        {
          "$ref": "#/$defs/comparisonRow",
          "type": "object",
          "properties": {
            "architecture_id": {
              "const": "direct_ternary_reference"
            }
          }
        },
        {
          "$ref": "#/$defs/comparisonRow",
          "type": "object",
          "properties": {
            "architecture_id": {
              "const": "frp_v1_7_0_quantized_shadow"
            }
          }
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": false
    },
    "integrity": {
      "$ref": "#/$defs/packageIntegrity"
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    },
    "comparison_package_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "workloadProfile": {
      "type": "object",
      "required": [
        "num_cells",
        "command_count",
        "seed",
        "issue_policy",
        "max_completion_cycles_per_command",
        "final_cooldown_cycles"
      ],
      "properties": {
        "num_cells": {
          "$ref": "#/$defs/positiveInteger"
        },
        "command_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "issue_policy": {
          "const": "transaction_serial"
        },
        "max_completion_cycles_per_command": {
          "$ref": "#/$defs/positiveInteger"
        },
        "final_cooldown_cycles": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "costProfile": {
      "type": "object",
      "required": [
        "profile_name",
        "cost_unit",
        "costs"
      ],
      "properties": {
        "profile_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "cost_unit": {
          "$ref": "#/$defs/nonemptyString"
        },
        "costs": {
          "$ref": "#/$defs/costClassValues"
        }
      },
      "additionalProperties": false
    },
    "thermalProfile": {
      "type": "object",
      "required": [
        "profile_name",
        "temperature_unit",
        "ambient_temperature_proxy",
        "thermal_decay",
        "thermal_gain"
      ],
      "properties": {
        "profile_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "temperature_unit": {
          "$ref": "#/$defs/nonemptyString"
        },
        "ambient_temperature_proxy": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "thermal_decay": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "thermal_gain": {
          "$ref": "#/$defs/nonnegativeNumber"
        }
      },
      "additionalProperties": false
    },
    "architectureRecord": {
      "type": "object",
      "required": [
        "architecture_id",
        "architecture_name",
        "architecture_result_sha256",
        "architecture_specific_metrics",
        "comparison_metrics",
        "integrity",
        "normalized_cost",
        "raw_event_totals",
        "thermal_proxy",
        "workload_sha256"
      ],
      "properties": {
        "architecture_id": {
          "enum": [
            "binary_synchronous_reference",
            "binary_clock_gated_reference",
            "direct_ternary_reference",
            "frp_v1_7_0_quantized_shadow"
          ]
        },
        "architecture_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "architecture_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "architecture_specific_metrics": {
          "type": "object",
          "additionalProperties": true
        },
        "comparison_metrics": {
          "$ref": "#/$defs/comparisonMetrics"
        },
        "integrity": {
          "$ref": "#/$defs/architectureIntegrity"
        },
        "normalized_cost": {
          "$ref": "#/$defs/normalizedCost"
        },
        "raw_event_totals": {
          "$ref": "#/$defs/rawEventTotals"
        },
        "thermal_proxy": {
          "$ref": "#/$defs/thermalProxy"
        },
        "workload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "binarySynchronousMetrics": {
      "type": "object",
