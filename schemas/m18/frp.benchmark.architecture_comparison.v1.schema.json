          "$ref": "#/$defs/nonnegativeNumber"
        },
        "p95_latency_ticks": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "maximum_latency_ticks": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "throughput_commands_per_tick": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "logical_state_changes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "encoded_bit_toggles": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "processor_cycles": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "active_clocked_cycles": {
          "$ref": "#/$defs/nonnegativeInteger"
