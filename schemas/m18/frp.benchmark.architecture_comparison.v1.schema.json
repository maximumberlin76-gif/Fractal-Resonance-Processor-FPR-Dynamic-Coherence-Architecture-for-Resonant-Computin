        },
        "pending_route_peak": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "prevented_direct_events": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "queue_overflow_events": {
          "const": 0
        },
        "requested_direct_events": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "reserved_state_events": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
