      "properties": {
        "C_minus_P_final": {
          "type": "number"
        },
        "C_minus_P_final_q16": {
          "type": "integer"
        },
        "C_minus_P_min": {
          "type": "number"
        },
        "C_minus_P_min_q16": {
          "type": "integer"
        },
        "actual_direct_events": {
          "const": 0
        },
        "fixed_point_thermal_sum_exact": {
          "const": true
        },
        "fixed_point_topology_sum_exact": {
          "const": true
        },
