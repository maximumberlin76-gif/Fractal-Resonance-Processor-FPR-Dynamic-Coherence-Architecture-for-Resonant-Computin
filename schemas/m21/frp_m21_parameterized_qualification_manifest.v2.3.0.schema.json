{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "raw_sha256": {
          "$ref": "#/$defs/digest"
        },
        "role": {
          "enum": [
            "parameter_dimensions",
            "qualification_matrix"
          ]
        },
        "schema": {
          "enum": [
            "frp.m21.parameter_dimensions.v2.3.0",
            "frp.m21.parameterized_qualification_matrix.v2.3.0"
          ]
        },
        "status": {
          "const": "PASS"
        }
      },
      "required": [
        "byte_length",
        "path",
        "raw_sha256",
        "role",
        "schema",
        "status"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "relative_path": {
      "minLength": 1,
      "not": {
        "pattern": "(^/)|(^|/)\\.\\.?(/|$)|\\\\"
      },
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "raw_sha256": {
          "$ref": "#/$defs/digest"
        },
        "role": {
          "enum": [
            "technical_source",
            "upstream_source"
          ]
        },
        "source_contour": {
          "enum": [
            "m21_technical_source",
            "m20_cross_layer_correlation",
            "m15_quantized_semantic_reference",
            "rtl_static_parameter_contract",
            "milestone_contract"
          ]
        }
      },
      "required": [
        "byte_length",
        "path",
        "raw_sha256",
        "role",
        "source_contour"
      ],
      "type": "object"
    }
  },
  "$id": "urn:frp:schema:frp.m21.parameterized_qualification_manifest.v2.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "m21_parameterized_qualification_manifest"
    },
    "milestone": {
      "const": "M21 — Parameterized Qualification Matrix"
    },
    "overall_status": {
      "const": "PASS"
    },
    "schema": {
      "const": "frp.m21.parameterized_qualification_manifest.v2.3.0"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_release": {
      "const": "FRP v2.2.0 / M20 correlation boundary"
    },
    "source_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "const": "2.3.0"
    }
  },
  "required": [
    "artifact_set_digest",
    "artifacts",
    "kind",
    "milestone",
    "overall_status",
    "schema",
    "source_commit",
    "source_release",
    "source_set_digest",
    "sources",
    "version"
  ],
  "title": "FRP M21 Parameterized Qualification Manifest",
  "type": "object"
}
