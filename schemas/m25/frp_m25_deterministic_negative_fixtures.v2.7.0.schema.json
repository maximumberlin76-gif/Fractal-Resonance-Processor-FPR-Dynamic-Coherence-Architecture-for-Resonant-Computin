{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frp.example/schemas/m25/frp_m25_deterministic_negative_fixtures.v2.7.0.schema.json",
  "title": "FRP M25 deterministic negative fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "milestone", "status", "source_commit", "contract_digest", "fixture_count", "scope_count", "fixtures", "fixture_set_digest"],
  "properties": {
    "schema_version": {"const": "2.7.0"},
    "artifact_id": {"const": "frp-m25-deterministic-negative-fixtures"},
    "milestone": {"const": "M25"},
    "status": {"const": "PASS"},
    "source_commit": {"const": "a01fb687fd1e4f0159f0d8cd885863afb8b87a1e"},
    "contract_digest": {"$ref": "#/$defs/digest"},
    "fixture_count": {"const": 13},
    "scope_count": {"const": 13},
    "fixtures": {
      "type": "array", "minItems": 13, "maxItems": 13,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fixture_id", "scope", "classification", "deterministic", "stimulus", "expected_outcome", "formal_property_ids", "fixture_digest"],
        "properties": {
          "fixture_id": {"type": "string", "pattern": "^M25-F(0[1-9]|1[0-3])$"},
          "scope": {"type": "string", "minLength": 8},
          "classification": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "deterministic": {"const": true},
          "stimulus": {"type": "string", "minLength": 4},
          "expected_outcome": {"type": "string", "minLength": 8},
          "formal_property_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^M25-P(0[1-9]|1[0-9]|2[0-5])$"}},
          "fixture_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "fixture_set_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
